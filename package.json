{
  "name": "zero",
  "version": "0.1.0",
  "private": true,
  "description": "A recursive self-improving agent built on singularity's procedural memory",
  "license": "MIT",
  "author": "pandacover",
  "homepage": "https://github.com/pandacover/zero-orch",
  "repository": {
    "type": "git",
    "url": "https://github.com/pandacover/zero-orch.git"
  },
  "type": "module",
  "main": "src/desktop/main.ts",
  "desktopName": "zero.desktop",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "zero": "src/cli.ts"
  },
  "scripts": {
    "zero": "node src/cli.ts",
    "app": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@effect/platform-node": "4.0.0",
    "@openai/codex-sdk": "0.163.0",
    "effect": "4.0.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "26.6.3",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  }
}
